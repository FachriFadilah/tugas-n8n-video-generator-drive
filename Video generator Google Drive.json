      "parameters": {
        "jsCode": "// Ambil data respons dari node Cek Status\nconst data = $input.first().json.data;\n\n// resultJson berupa string, ubah jadi objek JavaScript\nconst hasil = JSON.parse(data.resultJson);\nconst urls = hasil.resultUrls;\n\n// Validasi array hasil\nif (!Array.isArray(urls) || urls.length === 0) {\n  throw new Error('resultUrls kosong atau tidak ditemukan');\n}\n\n// Ambil URL pertama yang valid\nconst videoUrl = urls.find(u => typeof u === 'string' && u.startsWith('http'));\nif (!videoUrl) {\n  throw new Error('Tidak ada URL video yang valid');\n}\n\nreturn [{ json: { videoUrl } }];"
